// GVSOC reference model (ISS=GVSOC)
// - GVSOC_BRIDGE_HOME is a checkout of the RVVI bridge of the CV32E40P model of GVSOC.
//

-f ${GVSOC_BRIDGE_HOME}/sv/gvsoc_rvvi.f

// Reports the interrupt and debug inputs to the model and checks the order of the RVFI rows
${TBSRC_HOME}/uvmt/uvmt_cv32e40p_gvsoc_decision_monitor.sv

// GVSOC test bench wrapper
${TBSRC_HOME}/uvmt/uvmt_cv32e40p_gvsoc_wrap.sv
